<dl class="facts-list">
  <div><dt>Atención</dt><dd>Personas adultas</dd></div>
  <div><dt>Modalidad</dt><dd>Online y presencial</dd></div>
  <div><dt>Ubicación</dt><dd>{ADDRESS}</dd></div>
