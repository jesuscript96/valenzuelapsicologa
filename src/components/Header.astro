---
import BrandMark from './BrandMark.astro';
import { NAV } from '../data/site';

interface Props { page: string }
const { page } = Astro.props;
---
<header class="site-header">
  <div class="wrap bar">
    <BrandMark />
    <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav"><span class="lbl">Menú</span><span class="bars" aria-hidden="true"></span></button>
    <nav class="nav" id="site-nav" aria-label="Principal">
      {NAV.map((item) => (
        <a class="item" href={item.href} aria-current={item.slug === page ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn" href="/contacto">Pedir cita</a>
    </nav>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav')!;
  const btn = document.getElementById('menu-btn')!;
  const lbl = btn.querySelector('.lbl')!;
  btn.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    lbl.textContent = open ? 'Cerrar' : 'Menú';
  });
</script>
